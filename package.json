{
  "name": "claude-code-runner",
  "version": "0.1.0",
  "private": true,
  "description": "A small HTTP API that runs Claude Code sessions (Agent SDK) in project folders and hands their questions and permission prompts to another agent.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aformusatii/claude-code-runner.git"
  }
}
