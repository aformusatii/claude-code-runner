# Copy to .env (gitignored) and fill in. compose.yaml passes the whole file to the container.

# --- compose ---
APP_PORT=8064
DOCKER_GID=999
# Host folder mounted at /opt/workspace, and the host folder for the runner's home (create it first: mkdir home).
WORKSPACE_DIR=/home/you
HOME_DIR=./home

# --- runner ---
# Required. Callers send "Authorization: Bearer <API_TOKEN>". Generate: openssl rand -hex 24
API_TOKEN=
# Projects are the folders directly under this path (inside the container).
WORKSPACE_ROOT=/opt/workspace/repositories
# Sessions with a live Claude process (running or waiting for an answer).
MAX_ACTIVE_SESSIONS=3
# An unanswered question/permission is declined after this many minutes.
PROMPT_TIMEOUT_MINUTES=120
# default | acceptEdits | plan | auto | dontAsk | bypassPermissions (needs ALLOW_BYPASS_PERMISSIONS=true)
PERMISSION_MODE=default
ALLOW_BYPASS_PERMISSIONS=false
# Optional defaults for every session (a request can override them).
DEFAULT_MODEL=
MAX_TURNS=
MAX_BUDGET_USD=
# Optional: replaces the built-in "you run headless, ask short spoken questions" instructions.
SYSTEM_PROMPT_APPEND=
# Optional: POSTed {event, session, prompt?} on prompt / turn_done / failed.
WEBHOOK_URL=
WEBHOOK_TOKEN=

# --- Claude Code login (pick one; or run `claude /login` inside the container once) ---
# From `claude setup-token` (uses your Claude subscription):
CLAUDE_CODE_OAUTH_TOKEN=
# Or an API key from console.anthropic.com:
ANTHROPIC_API_KEY=

# --- optional: GitHub and git identity for commits/PRs made by Claude ---
GH_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
